@page "/customers"
@page "/zakaznici"
@rendermode InteractiveServer
@using Core.Customer
@using Core.Order
@using Core.Storage
@using Core.Trip
@using Web.Components.Shared
@using Web.Helpers
@inject OrderService OrderService
@inject CustomerService CustomerService
@inject TripService TripService

<PageHeader Title="@Title" Subtitle="@Subtitle">
    <Actions>
        <div class="relative">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                 class="size-4 text-text-faint absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
            <input class="input pl-9 w-72" type="text" placeholder="Hľadať meno, firmu, IČO, telefón..."
                   @bind="_searchQuery" @bind:event="oninput"/>
        </div>
        <button class="btn btn-primary" @onclick="() => _showAddModal = true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            Nový zákazník
        </button>
    </Actions>
    <Tabs>
        <ButtonGroup Data="@ButtonGroupData" SelectedKey="@_filter.SelectedKey" OnSelectedKeyChanged="@OnFilterChanged"/>
    </Tabs>
    <TabsRight>Zobrazených @Filtered.Count z @CustomersCount</TabsRight>
</PageHeader>

<div class="flex-1 overflow-hidden flex flex-col">
    @if (Filtered.Count == 0)
    {
        <EmptyContainer Title="Žiadny zákazníci" Description="Pridaj nového zákazníka tlačidlom vyššie.">
            <Icon>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6 text-text-faint">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                </svg>
            </Icon>
        </EmptyContainer>
    }
    else
    {
        <div class="flex flex-1 overflow-hidden h-full">
            <aside class="w-96 flex-shrink-0 border-r border-border bg-surface overflow-y-auto divide-y divide-border">
                @foreach (var item in Filtered)
                {
                    var isSelected = _selectedId == item.Id;
                    <div class="@($"flex items-center gap-4 px-4 py-3 cursor-pointer transition-colors {(isSelected ? "bg-accent-faint border-l-2 border-accent" : "border-l-2 border-transparent hover:bg-surface-hover")}")"
                         @onclick="() => _selectedId = item.Id">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-accent-soft">
                            <span class="text-sm font-semibold text-accent">@($"{item.FirstName.First()}{item.LastName.First()}")</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="font-semibold @(isSelected ? "text-accent" : "text-text") truncate">@((item.Ico is not null)? item.CompanyName : item.FullName)</div>
                            <div class="text-sm text-text-muted truncate">@((item.Ico is not null)? item.FullName : item.Email ?? item.PhoneNumber)</div>
                        </div>
                        <div class="text-right flex-shrink-0 pl-4">
                            <div class="font-semibold text-text">@OrderService.GetByCustomerId(item.Id).Count</div>
                            <div class="text-sm text-text-muted">@(OrderService.GetByCustomerId(item.Id).Count == 1 ? "zákazka" : "zákaziek")</div>
                        </div>
                    </div>
                }
            </aside>
            <div class="flex-1 overflow-y-auto bg-bg p-6 flex flex-col gap-4">
                @if (_selectedCustomer is not null)
                {
                    <div class="card p-4 flex flex-row gap-4 items-start">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-accent-soft">
                            <span class="text-sm font-semibold text-accent">@($"{_selectedCustomer.FirstName.First()}{_selectedCustomer.LastName.First()}")</span>
                        </div>
                        <div class="font-bold text-text flex flex-1 min-w-0">
                            @if (_selectedCustomer.Ico is null)
                            {
                                @_selectedCustomer.FullName
                                <div class="px-2">
                                    <Badge Label="Fyzická osoba" HighlightClass="scheduled">
                                        <Icon>
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
                                            </svg>
                                        </Icon>
                                    </Badge>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col">
                                    <div class="flex-row">
                                        @_selectedCustomer.CompanyName
                                        <Badge Label="Firma" HighlightClass="new">
                                            <Icon>
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>
                                                </svg>
                                            </Icon>
                                        </Badge>
                                    </div>
                                    <div class="font-normal text-sm">
                                        <span class="text-text-muted">Kontakt: </span>
                                        @_selectedCustomer.FullName
                                    </div>
                                    <div class="font-normal text-sm flex flex-row gap-2">
                                        <div>
                                            <span class="text-text-muted">IČO: </span>
                                            @(_selectedCustomer.Ico ?? "neznáme")
                                        </div>
                                        <div>
                                            <span class="text-text-muted">DIČ: </span>
                                            @(_selectedCustomer.Dic ?? "neznáme")
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="flex flex-col gap-2 flex-shrink-0">
                            <button class="btn btn-primary" @onclick="() => _showOrderModal = true">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                </svg>
                                Nová zákazka
                            </button>
                            <button class="btn" @onclick="() => _editingCustomer = _selectedCustomer">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                Upraviť
                            </button>
                        </div>
                    </div>
                    <div class="grid grid-cols-4 gap-3">
                        <StatCard Label="Zákazky celkom" Value="@_selectedCustomerOrders.Count.ToString()"/>
                        <StatCard 
                            Label="Doručené" 
                            Value="@(_selectedCustomerOrders
                                    .Where(o => o.Status == OrderStatus.Delivered)
                                    .ToList().Count.ToString())" 
                            Highlight="true"/>
                        <StatCard Label="Aktívne" 
                                  Value="@(_selectedCustomerOrders
                                    .Where(o => o.Status == OrderStatus.Assigned || o.Status == OrderStatus.EnRoute)
                                    .ToList().Count.ToString())" 
                                  Subtitle="zaradené + na ceste"/>
                        <StatCard Label="Hmotnosť spolu" Value="@($"{_selectedCustomerOrders.Sum(o => o.WeightTons):N2} t")"/>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        @* Kontaktné údaje *@
                        <div class="card p-4 flex flex-col gap-3">
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Kontaktné údaje</div>
                            <div class="divide-y divide-border">
                                <div class="flex items-center gap-3 py-3">
                                    <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-xs text-text-muted uppercase tracking-wide">Meno</div>
                                        <div class="text-sm text-text">@_selectedCustomer.FullName</div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 py-3">
                                    <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-xs text-text-muted uppercase tracking-wide">E-mail</div>
                                        @if (_selectedCustomer.Email is not null)
                                        {
                                            <div class="text-sm text-text">@_selectedCustomer.Email</div>
                                        }
                                        else
                                        {
                                            <div class="text-sm text-text-faint italic">nezadané</div>
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 py-3">
                                    <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 6.75Z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-xs text-text-muted uppercase tracking-wide">Telefón</div>
                                        <div class="text-sm text-text">@_selectedCustomer.PhoneNumber</div>
                                    </div>
                                </div>
                                @if (_selectedCustomer.Ico is not null)
                                {
                                    <div class="flex items-center gap-3 py-3">
                                        <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center flex-shrink-0">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="text-xs text-text-muted uppercase tracking-wide">Firma</div>
                                            <div class="text-sm text-text">@_selectedCustomer.CompanyName</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Predvolené miesta *@
                        <div class="card p-4 flex flex-col gap-3">
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Predvolené miesta</div>
                            <div class="divide-y divide-border">
                                <div class="flex items-center gap-3 py-3">
                                    <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-xs text-text-muted uppercase tracking-wide">Nakládka</div>
                                        @if (_selectedCustomer.DefaultPickupLocation is not null)
                                        {
                                            <div class="text-sm text-text">@_selectedCustomer.DefaultPickupLocation.DisplayName</div>
                                        }
                                        else
                                        {
                                            <div class="text-sm text-text-faint italic">nenastavené</div>
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center gap-3 py-3">
                                    <div class="w-8 h-8 rounded-lg bg-surface-2 flex items-center justify-center flex-shrink-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <div class="text-xs text-text-muted uppercase tracking-wide">Vykládka</div>
                                        @if (_selectedCustomer.DefaultDeliveryLocation is not null)
                                        {
                                            <div class="text-sm text-text">@_selectedCustomer.DefaultDeliveryLocation.DisplayName</div>
                                        }
                                        else
                                        {
                                            <div class="text-sm text-text-faint italic">nenastavené</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card overflow-hidden">
                        <div class="px-4 py-3 border-b border-border">
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">História zákaziek</div>
                        </div>
                        @if (_selectedCustomerOrders.Count == 0)
                        {
                            <div class="px-4 py-8 text-center text-sm text-text-faint italic">Žiadne zákazky</div>
                        }
                        else
                        {
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-border">
                                        <th class="px-4 py-3 text-left text-xs font-semibold text-text-muted uppercase tracking-wider">ID</th>
                                        <th class="px-4 py-3 text-left text-xs font-semibold text-text-muted uppercase tracking-wider">Trasa</th>
                                        <th class="px-4 py-3 text-left text-xs font-semibold text-text-muted uppercase tracking-wider">Stav</th>
                                        <th class="px-4 py-3 text-left text-xs font-semibold text-text-muted uppercase tracking-wider">Poznámka</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in _selectedCustomerOrders)
                                    {
                                        var badge = GetStatusBadge(order.Status);
                                        <tr class="border-b border-border last:border-0">
                                            <td class="px-4 py-3 text-sm font-semibold text-accent">Z-@order.Id.ToString()[..4].ToUpper()</td>
                                            <td class="px-4 py-3 text-sm text-text">
                                                @order.Origin.FullAddress.Split(',').Skip(1).FirstOrDefault()?.Trim()
                                                →
                                                @order.Destination.FullAddress.Split(',').Skip(1).FirstOrDefault()?.Trim()
                                            </td>
                                            <td class="px-4 py-3">
                                                <Badge Label="@badge.Label" HighlightClass="@badge.HighLightClass"/>
                                            </td>
                                            <td class="px-4 py-3 text-sm text-text-muted max-w-48 truncate">@(order.Note ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<OrderFormModal Visible="_showOrderModal"
               InitialCustomerId="_selectedId"
               OnClose="() => _showOrderModal = false"
               OnSaved="StateHasChanged"/>

<CustomerFormModal Visible="_showAddModal || _editingCustomer is not null"
                   EditingCustomer="_editingCustomer"
                   OnClose="CloseModal"
                   OnSaved="StateHasChanged"
                   OnDeleted="OnCustomerDeleted"/>

@code {
    private string Title = "Zákazníci";
    private string Subtitle = "Adresár firiem, ktoré pravidelne vozíme";
    
    private int CustomersCount => CustomerService.GetAll().Count;

    private enum CustomerType
    {
        Person, Company
    }

    private readonly StatusFilter<CustomerType, Customer> _filter = new(new Dictionary<string, CustomerType?>
    {
        { "Všetci", null },
        {"Firmy", CustomerType.Company},
        {"Fyzické osoby",  CustomerType.Person},
    });

    private List<Customer> Filtered => _filter.GetFiltered(CustomerService.GetAll, GetCustomersByType)
        .Where(c => string.IsNullOrWhiteSpace(_searchQuery) ||
            c.FullName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (c.CompanyName?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.Ico?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            c.PhoneNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();
    private List<(string Label, int Count)> ButtonGroupData => _filter.GetButtonGroupData(CustomerService.GetAll, GetCustomersByType);
    private void OnFilterChanged(string key) => _filter.Select(key);
    private List<Customer> GetCustomersByType(CustomerType customerType)
    {
        return CustomerService.GetAll()
            .Where(c => (customerType == CustomerType.Company) ? 
                c.Ico is not null : c.Ico is null
                ).ToList();
    }
        
    private string _searchQuery = "";
    private bool _showAddModal;
    private bool _showOrderModal;
    private Customer? _editingCustomer;

    private void CloseModal()
    {
        _showAddModal = false;
        _editingCustomer = null;
    }

    private void OnCustomerDeleted()
    {
        _selectedId = Guid.Empty;
        StateHasChanged();
    }

    private Guid _selectedId;
    private Customer? _selectedCustomer => CustomerService.GetById(_selectedId);
    private List<Order> _selectedCustomerOrders => OrderService.GetByCustomerId(_selectedId);

    private static (string HighLightClass, string Label) GetStatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.New       => ("new", "nová"),
        OrderStatus.Assigned  => ("scheduled", "zaradená"),
        OrderStatus.EnRoute   => ("ontrip", "na ceste"),
        OrderStatus.Delivered => ("delivered", "doručená"),
        OrderStatus.Cancelled => ("cancelled", "zrušená"),
        _                     => ("muted", "neznámy"),
    };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            OrderService.LoadAsync(),
            CustomerService.LoadAsync(),
            TripService.LoadAsync()
        );
    }

}