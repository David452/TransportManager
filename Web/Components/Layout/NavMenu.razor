@using Core.Customer
@using Core.Order
@using Core.Trip
@using Web.Components.Shared
@inject NavigationManager Nav
@inject OrderService OrderService
@inject TripService TripService
@inject CustomerService CustomerService

@code {
    string Current => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].ToLower();

    bool IsActive(string href) =>
        href == "/" ? Current == "" : Current.StartsWith(href.TrimStart('/'));

    string LinkClass(string href) => IsActive(href)
        ? "flex items-center gap-3 px-3 py-2 rounded-lg bg-accent-soft text-accent font-medium w-full"
        : "flex items-center gap-3 px-3 py-2 rounded-lg text-text hover:bg-surface-hover w-full transition-colors";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            OrderService.LoadAsync(),
            TripService.LoadAsync(),
            CustomerService.LoadAsync()
        );
    }

}

<div class="flex items-center gap-3 px-3 py-4 mb-4">
    <div class="w-11 h-11 rounded-xl bg-accent flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
        </svg>
    </div>
    <div>
        <div class="font-semibold text-text leading-tight">TransportManager</div>
        <div class="text-xs text-text-muted">Plánovač trás</div>
    </div>
</div>

<!-- Navigácia -->
<nav class="flex flex-col gap-1 px-2">

    <a href="/zakazky" class="@LinkClass("/zakazky")">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>

        <span class="flex-1">Zákazky</span>
        @if (OrderService.GetAll().Count != 0)
        {
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-surface-2 text-text-muted border border-border">@OrderService.GetAll().Count</span>
        }
    </a>

    <a href="/" class="@LinkClass("/")">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
        </svg>

        <span class="flex-1">Plánovač</span>
    </a>

    <a href="/tripy" class="@LinkClass("/tripy")">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
        </svg>

        <span class="flex-1">Tripy</span>
        @if (TripService.GetAll().Count != 0)
        {
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-surface-2 text-text-muted border border-border">@TripService.GetAll().Count</span>
        }
    </a>

    <a href="/zakaznici" class="@LinkClass("/zakaznici")">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
        </svg>

        <span class="flex-1">Zákazníci</span>
        @if (CustomerService.GetAll().Count != 0)
        {
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-surface-2 text-text-muted border border-border">@CustomerService.GetAll().Count</span>
        }
    </a>

</nav>

<div class="absolute bottom-4 left-0 w-full px-2">
    <ThemeToggle Class="" />
</div>


