@using Core.Trip
<div class="w-full border-b border-border bg-surface px-6 py-4 flex items-center justify-between gap-6">

    <div>
        <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Plánovač</div>
        <div class="text-lg font-bold text-text leading-tight">
            <span class="text-accent">@($"T-{Trip.Id.ToString()[..4].ToUpper()}")</span>
            <span class="ml-2">@FormatDate(Trip.DepartureDate)</span>
        </div>
    </div>

    <div class="flex items-center gap-1">

        <div class="flex items-center gap-3 px-4 py-2 rounded-lg">
            <div class="w-8 h-8 rounded-lg bg-surface-2 border border-border flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                </svg>
            </div>
            <div>
                <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Vzd.</div>
                <div class="text-base font-bold text-text">@(DistanceKm > 0 ? $"{DistanceKm} km" : "—")</div>
            </div>
        </div>

        <div class="w-px h-8 bg-border mx-1"></div>

        <div class="flex items-center gap-3 px-4 py-2 rounded-lg">
            <div class="w-8 h-8 rounded-lg bg-surface-2 border border-border flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
            </div>
            <div>
                <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Jazda</div>
                <div class="text-base font-bold text-text">@FormatDuration(Duration)</div>
            </div>
        </div>

        <div class="w-px h-8 bg-border mx-1"></div>

        <div class="flex items-center gap-3 px-4 py-2 rounded-lg">
            <div class="w-8 h-8 rounded-lg bg-surface-2 border border-border flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-text-muted">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"/>
                </svg>
            </div>
            <div>
                <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Záks.</div>
                <div class="text-base font-bold text-text">2</div>
            </div>
        </div>

        <div class="w-px h-8 bg-border mx-1"></div>

        <div class="pl-3">
            <button class="btn btn-primary gap-2" @onclick="OnSave">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                </svg>
                Uložiť trip
            </button>
        </div>

    </div>

</div>

@code {
    
    [Parameter] public required Trip Trip { get; set; }
    [Parameter] public int DistanceKm { get; set; }
    [Parameter] public TimeSpan Duration { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private static string FormatDuration(TimeSpan t)
    {
        if (t == TimeSpan.Zero) return "—";
        return t.Hours > 0
            ? $"{t.Hours} h {t.Minutes} min"
            : $"{t.Minutes} min";
    }

    private static string FormatDate(DateOnly date)
    {
        var dayNames = new[] { "Nedeľa", "Pondelok", "Utorok", "Streda", "Štvrtok", "Piatok", "Sobota" };
        var monthNames = new[] { "", "jan", "feb", "mar", "apr", "máj", "jún", "júl", "aug", "sep", "okt", "nov", "dec" };
        return $"{dayNames[(int)date.DayOfWeek]}, {date.Day}. {monthNames[date.Month]}";
    }

}
