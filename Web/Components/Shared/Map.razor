@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_mapId" style="height: @Height; width: 100%; border-radius: 0.5rem;"></div>

@code {
    // Využitie generatívnej AI: návrh JS interop vrstvy (initMap/showRoute/disposeMap)
    // a ošetrenie výnimiek pri disposingu odpojeného Blazor okruhu.
    [Parameter] public string Height { get; set; } = "400px";
    [Parameter] public bool Interactive { get; set; } = true;

    private readonly string _mapId = $"map-{Guid.NewGuid():N}";
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initMap", _mapId, Interactive);
            _initialized = true;
        }
    }

    public async Task ShowRoute(IEnumerable<double[]> polylinePoints, IEnumerable<MapMarker> markers)
    {
        if (!_initialized) return;
        await JS.InvokeVoidAsync("showRoute", _mapId, polylinePoints, markers);
    }

    public record MapMarker(double[] Coords, string Label);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeMap", _mapId);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

}