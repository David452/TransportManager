@using Core.Geocoding
@using Core.Order
@using Core.OSRM
@using Core.Trip
@inject TripService TripService
@inject OrderService OrderService
@inject IRouteService RouteService
@inject NavigationManager NavManager

@if (Visible && Trip is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" @onclick="Close"></div>
        <div class="relative z-10 bg-surface border border-border rounded-2xl shadow-xl w-full max-w-lg mx-4 flex flex-col max-h-[90vh]">

            <div class="flex items-center gap-4 px-6 py-5 border-b border-border flex-shrink-0">
                <div class="w-10 h-10 rounded-xl bg-surface-2 border border-border flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-text-muted">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold text-accent">T-@Trip.Id.ToString()[..4].ToUpper()</span>
                        <Badge Label="@StatusLabel" HighlightClass="@StatusHighlight"/>
                    </div>
                    <div class="text-lg font-bold text-text leading-tight">@FormatDate(Trip.DepartureDate)</div>
                </div>
                <button class="text-text-faint hover:text-text transition-colors" @onclick="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div class="overflow-y-auto flex-1 px-6 py-5 flex flex-col gap-5">

                <div class="bg-surface-2 border border-border rounded-xl px-4 py-3 flex flex-col gap-2">
                    <div class="text-xs font-semibold text-text-muted">BA-321 GH (DAF XF)</div>
                    <div class="text-sm font-bold text-text">@RouteStopsText</div>
                    <div class="grid grid-cols-4 gap-3 pt-1 border-t border-border mt-1">
                        <div>
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Vzdialenosť</div>
                            <div class="text-sm font-bold text-text mt-0.5">@(_route is null ? "…" : $"{(int)_route.DistanceKm} km")</div>
                        </div>
                        <div>
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Jazda</div>
                            <div class="text-sm font-bold text-text mt-0.5">@(_route is null ? "…" : FormatDuration(_route.Duration))</div>
                        </div>
                        <div>
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Zákazky</div>
                            <div class="text-sm font-bold text-text mt-0.5">@Trip.OrderIds.Count()</div>
                        </div>
                        <div>
                            <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Zastávky</div>
                            <div class="text-sm font-bold text-text mt-0.5">@Trip.Stops.Count</div>
                        </div>
                    </div>
                </div>

                @if (Trip.Status != TripStatus.Completed)
                {
                    <div class="flex flex-col gap-2">
                        <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Zmeniť stav</div>
                        @if (Trip.Status == TripStatus.Scheduled)
                        {
                            <button class="flex items-center gap-4 bg-accent hover:bg-accent/90 transition-colors rounded-xl px-4 py-3.5 text-left" @onclick="StartTrip">
                                <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5 text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-white">Zaradiť do cesty</div>
                                    <div class="text-xs text-white/70 mt-0.5">Trip sa označí ako prebiehajúci a začne sa zaznamenávať jazda.</div>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-white/60 flex-shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
                                </svg>
                            </button>
                        }
                        else if (Trip.Status == TripStatus.OnGoing)
                        {
                            <button class="flex items-center gap-4 bg-green-600 hover:bg-green-700 transition-colors rounded-xl px-4 py-3.5 text-left" @onclick="CompleteTrip">
                                <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-5 text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-white">Dokončiť trip</div>
                                    <div class="text-xs text-white/70 mt-0.5">Trip sa označí ako dokončený a zákazky sa uzatvoria.</div>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-white/60 flex-shrink-0">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
                                </svg>
                            </button>
                        }
                    </div>
                }

                @if (Trip.Status != TripStatus.Completed)
                {
                <div class="flex flex-col gap-2">
                    <div class="text-xs font-semibold tracking-widest text-text-muted uppercase">Ďalšie</div>
                    <button class="flex items-center gap-4 bg-surface border border-border hover:bg-surface-2 transition-colors rounded-xl px-4 py-3.5 text-left" @onclick="OpenInPlanner">
                        <div class="w-9 h-9 rounded-lg bg-surface-2 border border-border flex items-center justify-center flex-shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-text-muted">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-text">Otvoriť v plánovači</div>
                            <div class="text-xs text-text-muted mt-0.5">Uprav zastávky, poradie a priradené zákazky.</div>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 text-text-faint flex-shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
                        </svg>
                    </button>
                </div>
                }

            </div>

            <div class="flex items-center justify-between px-6 py-4 border-t border-border flex-shrink-0">
                @if (_confirmDelete)
                {
                    <span class="text-sm text-text-muted">Naozaj odstrániť trip?</span>
                    <div class="flex items-center gap-2">
                        <button class="btn" @onclick="() => _confirmDelete = false">Nie</button>
                        <button class="btn text-red-500 border-red-200 hover:bg-red-50" @onclick="DeleteTrip">Áno, odstrániť</button>
                    </div>
                }
                else
                {
                    <button class="btn text-red-500 border-red-200 hover:bg-red-50 gap-2" @onclick="() => _confirmDelete = true">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                        </svg>
                        Vymazať trip
                    </button>
                    <button class="btn" @onclick="Close">Zavrieť</button>
                }
            </div>

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter] public Trip? Trip { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private RouteResult? _route;
    private bool _confirmDelete;

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible || Trip is null) return;
        _confirmDelete = false;
        await LoadRoute();
    }

    private async Task LoadRoute()
    {
        if (Trip is null) return;
        var stops = Trip.Stops
            .Select(s =>
            {
                var order = OrderService.GetById(s.OrderId);
                if (order is null) return (GeoLocation?)null;
                return s.Type == StopType.Pickup ? order.Origin : order.Destination;
            })
            .Where(l => l is not null && (l.Latitude != 0 || l.Longitude != 0))
            .Select(l => l!)
            .ToList();

        if (stops.Count < 2) return;
        _route = await RouteService.GetRouteAsync(stops); 
    }

    private async Task StartTrip()
    {
        if (Trip is null) return;
        await TripService.UpdateAsync(Trip.Id, t => t.Start());
        await Task.WhenAll(Trip.OrderIds.Select(id => OrderService.UpdateAsync(id, o => o.Status = OrderStatus.EnRoute)));
        await OnChanged.InvokeAsync();
    }

    private async Task CompleteTrip()
    {
        if (Trip is null) return;
        await TripService.UpdateAsync(Trip.Id, t => t.Complete());
        await Task.WhenAll(Trip.OrderIds.Select(id => OrderService.UpdateAsync(id, o => o.Status = OrderStatus.Delivered)));
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteTrip()
    {
        if (Trip is null) return;
        var cancelTasks = Trip.OrderIds
            .Select(id => OrderService.UpdateAsync(id, o => o.Status = OrderStatus.Cancelled));
        await Task.WhenAll(cancelTasks);
        await TripService.DeleteAsync(Trip.Id);
        await OnDeleted.InvokeAsync();
        Close();
    }

    private void OpenInPlanner()
    {
        if (Trip is null) return;
        NavManager.NavigateTo($"/?trip={Trip.Id}");
    }

    private void Close()
    {
        _confirmDelete = false;
        OnClose.InvokeAsync();
    }

    private string RouteStopsText
    {
        get
        {
            if (Trip is null) return "—";
            var names = Trip.Stops
                .Select(s =>
                {
                    var order = OrderService.GetById(s.OrderId);
                    if (order is null) return null;
                    return (s.Type == StopType.Pickup ? order.Origin : order.Destination).DisplayName;
                })
                .Where(n => n is not null)
                .Distinct()
                .ToList();
            return names.Count == 0 ? "—" : string.Join(" → ", names);
        }
    }

    private string StatusLabel => Trip?.Status switch
    {
        TripStatus.Scheduled => "Plánovaný",
        TripStatus.OnGoing   => "Prebieha",
        TripStatus.Completed => "Dokončený",
        _                    => "Neznámy",
    };

    private string StatusHighlight => Trip?.Status switch
    {
        TripStatus.Scheduled => "new",
        TripStatus.OnGoing   => "ontrip",
        TripStatus.Completed => "delivered",
        _                    => "muted",
    };

    private static string FormatDuration(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours} h {t.Minutes} min" : $"{t.Minutes} min";

    private static string FormatDate(DateOnly date)
    {
        var dayNames = new[] { "Nedeľa", "Pondelok", "Utorok", "Streda", "Štvrtok", "Piatok", "Sobota" };
        var monthNames = new[] { "", "jan", "feb", "mar", "apr", "máj", "jún", "júl", "aug", "sep", "okt", "nov", "dec" };
        return $"{dayNames[(int)date.DayOfWeek]}, {date.Day}. {monthNames[date.Month]}";
    }
}
